<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <!-- Core shows its internals to this assembly name, so the harness can call the helpers directly. -->
    <AssemblyName>InterviewMaster.Core.Tests</AssemblyName>
    <RootNamespace>InterviewMaster.Parity</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../src/InterviewMaster.Core/InterviewMaster.Core.csproj" />
  </ItemGroup>
</Project>
